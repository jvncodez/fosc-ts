# Copy this file to .env.cognito, replace the placeholders, then run:
#   set -a; source .env.cognito; set +a
#   bin/fosc -v -p 5555
#
# Do NOT put AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
# Cognito passwords, or a client secret in this file. This local viewer uses a
# public Cognito app client with Authorization Code + PKCE, so it has NO secret.

SENTINELA_COGNITO_ENABLED=1
SENTINELA_COGNITO_DOMAIN=https://YOUR_DOMAIN_PREFIX.auth.us-east-1.amazoncognito.com
SENTINELA_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
SENTINELA_COGNITO_CLIENT_ID=YOUR_PUBLIC_APP_CLIENT_ID
SENTINELA_COGNITO_REDIRECT_URI=http://127.0.0.1:5555/auth/callback
SENTINELA_COGNITO_SCOPES="openid profile email"
